{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.3.0",
  "default_locale": "zh_CN",
  "description": "__MSG_extDesc__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  },
  "permissions": ["activeTab", "downloads", "storage"],
  "host_permissions": ["https://*.xiaohongshu.com/*", "https://*.xhscdn.com/*", "https://*.xhscdn.net/*"],
  "action": {
    "default_title": "波波小红书下载",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/*", "https://xiaohongshu.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bobo-xhs-downloader@bobo.app",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://www.xiaohongshu.com/*", "https://xiaohongshu.com/*"]
    }
  ]
}
